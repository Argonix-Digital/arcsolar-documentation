{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ArcSolar Documentation | The Solar Retailer Operating System",
  "colors": {
    "primary": "#3D88F2",
    "light": "#95C1FF",
    "dark": "#E05E39"
  },
  "favicon": {
    "light": "/images/ArgonixConnectIcon.svg",
    "dark": "/images/arcsolar-icon.svg"
  },
  "navigation": {
